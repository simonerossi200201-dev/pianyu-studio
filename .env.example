# ============================================================================
# 片语工作室 (Cutora LTX Studio v3.0) — 环境变量配置模板 (.env.example)
# 说明：
# 1. 本项目所有敏感 API Key / OAuth Token 默认通过 Windows 系统凭据管理器
#    (WinVaultKeyring / CredWriteW, 服务名: LTX_STUDIO_VAULT) 安全加密存储，
#    严禁在代码、配置文件或 Git 仓库中硬编码任何真实密钥。
# 2. 如需通过环境变量注入或覆盖配置，请将本文件复制为 `.env`（已被 .gitignore 忽略）并填写。
# ============================================================================

# 本地算力网关监听地址与端口（默认仅绑定本机回环地址 127.0.0.1）
STUDIO_API_HOST=127.0.0.1
STUDIO_API_PORT=7870

# 本地 ComfyUI 推理引擎地址（仅本机回环）
COMFY_URL=http://127.0.0.1:8188

# 默认项目工作区根目录
STUDIO_WORKSPACE_ROOT=D:\1_PROJECT

# 可选：云端大模型辅助 API Key（建议使用软件内设置界面存入 Windows 凭据管理器）
GEMINI_API_KEY=
XAI_GROK_API_KEY=
OPENAI_API_KEY=

# 离线安全模式开关（1 = 强制本地 HuggingFace 权重离线加载，不发起外部联网请求）
HF_HUB_OFFLINE=1
PYTHONUTF8=1
