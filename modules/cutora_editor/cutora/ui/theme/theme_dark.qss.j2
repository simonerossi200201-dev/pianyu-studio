/* Studio Graphite / Roma — generated QSS. Tokens from cutora/ui/theme/tokens.py */

* {
    font-family: "{{ font_ui }}", "{{ font_cjk }}", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
}

QMainWindow {
    background-color: {{ bg0 }};
    color: {{ fg0 }};
    font-size: {{ font_body }}px;
}
QMainWindow::separator {
    background: {{ bg0 }};
    width: {{ space_2 }}px;
    height: {{ space_2 }}px;
    border: none;
}
QMainWindow::separator:hover {
    background: {{ accent }};
    border: {{ space_1 }}px solid {{ bg0 }};
}
QWidget#dockHandle {
    background: {{ bg0 }};
    height: {{ space_1 }}px;
    max-height: {{ space_1 }}px;
    border: none;
}
QWidget#timelineFiller {
    background: {{ bg1 }};
}
QWidget#GuardWindow {
    background-color: {{ bg1 }};
    color: {{ fg0 }};
}
QDialog, QMessageBox, QInputDialog, QFileDialog {
    background-color: {{ bg1 }};
    color: {{ fg0 }};
}
QLabel {
    color: {{ fg0 }};
    font-weight: {{ w_regular }};
    background: transparent;
}
QLabel#hint, QLabel#formHint, QLabel#TopVolLabel, QLabel#TopIntroLabel, QLabel#sub {
    color: {{ fg1 }};
    font-size: {{ font_sm }}px;
}
QLabel#okHint { color: {{ ok }}; font-size: {{ font_sm }}px; }
QLabel#warnHint { color: {{ warn }}; font-size: {{ font_sm }}px; }
QLabel#errHint { color: {{ err_text }}; font-size: {{ font_sm }}px; }
QLabel#sectionHeader {
    color: {{ accent }};
    font-size: {{ font_sm }}px;
    font-weight: {{ w_semi }};
    padding: {{ space_1 }}px 0;
}
QLabel#title { font-size: {{ font_title }}px; font-weight: {{ w_semi }}; color: {{ fg0 }}; }
QLabel#pageTitle { font-size: {{ font_page }}px; font-weight: {{ w_semi }}; color: {{ fg0 }}; }

QGroupBox {
    border: 1px solid {{ line }};
    margin-top: {{ space_2 }}px;
    background-color: {{ bg1 }};
    border-radius: {{ radius_ctl }}px;
    color: {{ fg0 }};
    padding: {{ space_2 }}px {{ space_2 }}px {{ space_2 }}px {{ space_2 }}px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: {{ space_2 }}px;
    padding: 0 {{ space_1h }}px;
    color: {{ fg1 }};
}
QGroupBox#bareGroup {
    border: none;
    margin: 0;
    padding: {{ space_quarter }}px 0;
    background: transparent;
}

QPushButton {
    background-color: {{ bg3 }};
    border: 1px solid {{ border }};
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1 }}px {{ space_2 }}px;
    min-height: {{ control_h }}px;
    color: {{ fg0 }};
    font-size: {{ font_sm }}px;
    font-weight: {{ w_regular }};
}
QPushButton:hover { background-color: {{ bg2 }}; border-color: {{ accent_dim }}; }
QPushButton:pressed { background-color: {{ accent_dim }}; }
QPushButton:disabled { background-color: {{ bg1 }}; border: 1px solid {{ line }}; color: {{ fg_muted }}; }
QPushButton#btn_ai, QPushButton#btn_exp, QPushButton#btn_batch_export,
QPushButton#btn_batch_ai, QPushButton#btnPrimary, QPushButton#btn_primary,
QPushButton#btn_apply_now {
    background-color: {{ accent_dim }};
    border: 1px solid {{ accent }};
    color: {{ fg0 }};
    font-weight: {{ w_semi }};
    min-height: {{ control_h_lg }}px;
}
QPushButton#btn_ai:hover, QPushButton#btn_exp:hover, QPushButton#btn_batch_export:hover,
QPushButton#btn_batch_ai:hover, QPushButton#btnPrimary:hover, QPushButton#btn_primary:hover,
QPushButton#btn_apply_now:hover { background-color: {{ accent }}; }
QPushButton#btnSecondary {
    background-color: {{ bg2 }};
    border: 1px solid {{ line }};
    color: {{ fg0 }};
    font-weight: {{ w_regular }};
}
QPushButton#btnSecondary:hover { background-color: {{ bg3 }}; border-color: {{ accent_dim }}; }
QPushButton#btnSecondary:pressed { background-color: {{ accent_dim }}; }
QPushButton#btn_exp_stop {
    background-color: {{ bg2 }};
    border: 1px solid {{ line }};
    color: {{ fg0 }};
}
QPushButton#btn_exp_stop:hover { background-color: {{ bg3 }}; }
QPushButton#btnDanger {
    color: {{ err }};
    background: transparent;
    font-weight: {{ w_semi }};
    border: none;
    min-height: {{ control_h }}px;
    padding: 0;
}
QPushButton#TopMiniBtn, QPushButton#TopVolApply {
    height: {{ control_h_lg }}px;
    min-height: {{ control_h_lg }}px;
    padding: {{ space_1 }}px {{ space_2 }}px;
    border-radius: {{ radius_card }}px;
    font-size: {{ font_sm }}px;
}

QToolButton {
    background-color: {{ fg0_08 }};
    border: 1px solid {{ fg0_10 }};
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1 }}px;
    color: {{ fg0 }};
}
QToolButton:hover { background-color: {{ bg3 }}; }
QToolButton:pressed { background-color: {{ accent_dim }}; }
QWidget#previewTools QToolButton {
    background: transparent;
    border: none;
    border-radius: {{ radius_card }}px;
    padding: 0px;
}
QWidget#previewTools QToolButton:hover { background: {{ fg0_08 }}; }
QWidget#previewTools QToolButton:pressed { background: {{ accent_dim }}; }
QToolButton#stylepackEditBtn {
    background-color: {{ bg0_78 }};
    border: 1px solid {{ fg0_28 }};
    border-radius: {{ radius_dlg }}px;
    padding: {{ space_quarter }}px;
    color: {{ fg0 }};
}
QToolButton#stylepackEditBtn:hover {
    background-color: {{ bg3 }};
    border: 1px solid {{ accent }};
}
QToolButton#stylepackEditBtn:pressed { background-color: {{ accent_dim }}; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
    background-color: {{ bg2 }};
    color: {{ fg0 }};
    border: 1px solid {{ border }};
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1 }}px {{ space_1h }}px;
    selection-background-color: {{ accent_35 }};
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: {{ bg1 }};
    color: {{ fg_muted }};
    border: 1px solid {{ line }};
}
QSpinBox, QDoubleSpinBox { padding-right: {{ space_4 }}px; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: {{ icon_md }}px;
    height: {{ space_3 }}px;
    background: {{ bg3 }};
    border-left: 1px solid {{ line }};
    border-bottom: 1px solid {{ line }};
    border-top-right-radius: {{ radius_ctl }}px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: {{ icon_md }}px;
    height: {{ space_3 }}px;
    background: {{ bg3 }};
    border-left: 1px solid {{ line }};
    border-top: 1px solid {{ line }};
    border-bottom-right-radius: {{ radius_ctl }}px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: {{ accent_dim }};
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: {{ accent }};
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url({{ qss_chevron_up }});
    width: {{ space_2 }}px; height: {{ space_2 }}px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url({{ qss_chevron_down }});
    width: {{ space_2 }}px; height: {{ space_2 }}px;
}
QTextEdit {
    background-color: {{ bg2 }};
    color: {{ fg0 }};
    border: 1px solid {{ border }};
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1h }}px {{ space_2 }}px;
    selection-background-color: {{ accent_35 }};
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid {{ accent }};
}
QTextEdit#text_input {
    border: 1px solid {{ fg0_12 }};
    border-radius: {{ radius_dlg }}px;
    background: {{ fg0_08 }};
    padding: {{ space_3 }}px;
    color: {{ fg0 }};
}
QPlainTextEdit, QTextEdit#mono {
    font-family: "{{ font_mono }}", "Consolas", monospace;
    font-size: {{ font_sm }}px;
}
QPlainTextEdit#transcriptEditor {
    font-family: "{{ font_ui }}", "{{ font_cjk }}", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: {{ font_body }}px;
}
QComboBox { padding-right: {{ space_5 }}px; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: {{ square_sm }}px;
    border: none;
    border-radius: 0;
    background: transparent;
}
QComboBox::drop-down:hover,
QComboBox::drop-down:disabled {
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url({{ qss_chevron_down }});
    width: {{ space_2 }}px;
    height: {{ space_2 }}px;
}
QComboBox QAbstractItemView {
    background: {{ bg1 }};
    color: {{ fg0 }};
    border: 1px solid {{ line }};
    selection-background-color: {{ accent_35 }};
    outline: 0;
}
QComboBox QAbstractItemView::item { padding: {{ space_1 }}px {{ space_2 }}px; }

QTabWidget::pane {
    background-color: {{ bg1 }};
    border: none;
    border-radius: 0;
}
QTabBar::tab {
    background-color: {{ bg2 }};
    color: {{ fg1 }};
    padding: {{ space_1h }}px {{ space_3 }}px;
    border: 1px solid {{ line }};
    border-bottom: none;
    border-top-left-radius: {{ radius_card }}px;
    border-top-right-radius: {{ radius_card }}px;
    margin-right: {{ space_1 }}px;
}
QTabBar::tab:selected {
    background-color: {{ bg3 }};
    color: {{ fg0 }};
    border-bottom: {{ space_quarter }}px solid {{ accent }};
}
QTabWidget QWidget { background-color: {{ bg1 }}; color: {{ fg0 }}; }

QSplitter::handle { background: {{ fg0_08 }}; }
QSplitter::handle:vertical { height: {{ space_1h }}px; margin: 0px {{ space_2 }}px; border-radius: {{ radius_sm }}px; }
QSplitter::handle:horizontal { width: {{ space_quarter }}px; }
QSplitter::handle:hover { background: {{ fg0_16 }}; }
/* Q106: 首页三栏的分隔条平时完全看不见，鼠标悬上去才现出一条细金线。
   句柄仍有 space_3 的宽度好抓；左右各收 space_1、上下各收 space_6，
   于是亮出来的只是一条又细又短的圆头小线，不是一整条粗亮竖条。 */
/* Q126：选中文本时浮在预览上方的工具条 */
QFrame#textContextBar {
    background-color: {{ bg1 }};
    border: 1px solid {{ fg0_28 }};
    border-radius: {{ radius_card }}px;
}
QFrame#textContextBar QSpinBox, QFrame#textContextBar QDoubleSpinBox,
QFrame#textContextBar QComboBox {
    /* 和右侧面板同一个高度权威：内容 insp_ctl_inner + 1px 边框 x2 */
    min-height: {{ insp_ctl_inner }}px;
    max-height: {{ insp_ctl_inner }}px;
    padding-top: 0; padding-bottom: 0;
}
/* Q170：字体选择器弹窗（每个字体用自己的字形显示，后台渲染） */
QFrame#fontPicker {
    background-color: {{ bg1 }};
    border: 1px solid {{ fg0_28 }};
    border-radius: {{ radius_card }}px;
}
QFrame#fontPicker QLineEdit#fontPickerSearch {
    background: {{ bg2 }};
    border: none;
    border-bottom: 1px solid {{ line }};
    border-radius: 0;
    padding: {{ space_2 }}px {{ space_3 }}px;
    min-height: {{ control_h_lg }}px;
    color: {{ fg0 }};
    font-size: {{ font_body }}px;
}
QFrame#fontPicker QListView#fontPickerList {
    background: {{ bg1 }};
    border: none;
    outline: none;
}
QFrame#fontPicker QListView#fontPickerList::item { border: none; padding: 0; }
QFrame#fontPicker QListView#fontPickerList::item:selected { background: transparent; }
QFrame#fontPicker QListView#fontPickerList::item:hover { background: transparent; }
/* Q152-A / F 关键帧编辑器、节点编辑器工具条：平铺按钮，选中态用金色 */
QWidget#keyframeEditor, QWidget#nodeEditor { background: {{ bg1 }}; }
QWidget#keyframeEditor QToolButton, QWidget#nodeEditor QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_quarter }}px {{ space_2 }}px;
    color: {{ fg1 }};
}
QWidget#keyframeEditor QToolButton:hover, QWidget#nodeEditor QToolButton:hover { background: {{ fg0_08 }}; color: {{ fg0 }}; }
QWidget#keyframeEditor QToolButton:pressed, QWidget#nodeEditor QToolButton:pressed { background: {{ accent_dim }}; }
QWidget#keyframeEditor QToolButton:checked, QWidget#nodeEditor QToolButton:checked {
    background: {{ fg0_08 }};
    border-color: {{ accent }};
    color: {{ fg0 }};
}
QWidget#keyframeEditor QToolButton:disabled, QWidget#nodeEditor QToolButton:disabled { color: {{ fg_muted }}; }
QFrame#textContextBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1 }}px;
}
QFrame#textContextBar QToolButton:hover { background: {{ fg0_08 }}; }
QFrame#textContextBar QToolButton:checked {
    background: {{ accent_dim }};
    border-color: {{ accent }};
}
QFrame#textContextBar QFrame#ctxSep {
    background: {{ fg0_28 }};
    border: none;
    margin: 0 {{ space_1 }}px;
}
QFrame#textContextBar QLabel#ctxLabel { color: {{ fg2 }}; padding-left: {{ space_1 }}px; }

/* Q127：画布上所见即所得的隐形编辑框 —— 字由 textfx 画，它自己什么都不显示 */
QTextEdit#canvasTextEditor, QTextEdit#canvasTextEditor QWidget {
    background: transparent;
    border: none;
    color: transparent;
    selection-background-color: transparent;
    selection-color: transparent;
}

/* Q128：文本样式画廊（弹出层） */
QFrame#textStyleGallery {
    background-color: {{ bg1 }};
    border: 1px solid {{ fg0_28 }};
    border-radius: {{ radius_card }}px;
}
QFrame#textStyleGallery QLabel#ctxLabel { color: {{ fg1 }}; font-weight: 600; }
QFrame#textStyleGallery QListWidget#textStyleList {
    background: transparent;
    border: none;
    color: {{ fg1 }};
}
QFrame#textStyleGallery QListWidget#textStyleList::item {
    border: 1px solid transparent;
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1 }}px;
}
QFrame#textStyleGallery QListWidget#textStyleList::item:hover { background: {{ fg0_08 }}; }
QFrame#textStyleGallery QListWidget#textStyleList::item:selected {
    background: {{ accent_dim }};
    border-color: {{ accent }};
}

/* Q191 房间：卡片之间的分隔条平时看不见，鼠标经过才亮一道细线（同主界面的停靠分隔） */
QSplitter#roomSplit::handle { background: transparent; border: none; }
QSplitter#roomSplit::handle:horizontal { width: {{ space_3 }}px; }
QSplitter#roomSplit::handle:vertical { height: {{ space_3 }}px; }
QSplitter#roomSplit::handle:horizontal:hover,
QSplitter#roomSplit::handle:horizontal:pressed {
    background-color: {{ accent }};
    margin: {{ space_6 }}px {{ space_1h }}px {{ space_6 }}px {{ space_1 }}px;
}
QSplitter#roomSplit::handle:vertical:hover,
QSplitter#roomSplit::handle:vertical:pressed {
    background-color: {{ accent }};
    margin: {{ space_1 }}px {{ space_6 }}px {{ space_1h }}px {{ space_6 }}px;
}
QFrame#roomCard {
    background-color: {{ bg1 }};
    border: 1px solid {{ fg0_08 }};
    border-radius: {{ radius_card }}px;
}
QFrame#roomCard QScrollArea, QFrame#roomCard QScrollArea > QWidget > QWidget { background: transparent; }
/* Q192 主窗口里的浮层 / 侧滑面板（原来的独立弹窗） */
QFrame#sheetCard {
    background-color: {{ bg1 }};
    border: 1px solid {{ fg0_10 }};
    border-radius: {{ radius_dlg }}px;
}
QLabel#sheetTitle { color: {{ fg0 }}; font-weight: {{ w_semi }}; font-size: {{ font_body }}px; }
QPushButton#sheetClose {
    background: transparent;
    border: none;
    color: {{ fg1 }};
    border-radius: {{ radius_ctl }}px;
    padding: 0px;
    min-height: 0px;
    min-width: 0px;
}
QPushButton#sheetClose:hover { background: {{ fg0_10 }}; color: {{ fg0 }}; }
QToolBar#pageBar { background: {{ bg0 }}; border: none; padding: 0px; spacing: 0px; margin: 0px; }
QTableWidget#batchTextTable { border-radius: {{ radius_card }}px; }
QTableWidget#batchTextTable QHeaderView::section:horizontal:first { border-top-left-radius: {{ radius_card }}px; }
QTableWidget#batchTextTable QHeaderView::section:horizontal:last { border-top-right-radius: {{ radius_card }}px; border-right: none; }

QSplitter#welcomeSplit::handle { background: transparent; border: none; }
QSplitter#welcomeSplit::handle:horizontal { width: {{ space_3 }}px; }
QSplitter#welcomeSplit::handle:horizontal:hover,
QSplitter#welcomeSplit::handle:horizontal:pressed {
    background-color: {{ accent }};
    margin: {{ space_6 }}px {{ space_1 }}px;
    border-radius: {{ radius_sm }}px;
}

QCheckBox { color: {{ fg1 }}; spacing: {{ space_2 }}px; }
QCheckBox::indicator {
    width: {{ icon_sm }}px; height: {{ icon_sm }}px;
    border: 1px solid {{ fg0_25 }};
    border-radius: {{ radius_sm }}px;
    background: {{ bg2 }};
}
QCheckBox::indicator:hover { border-color: {{ accent }}; background: {{ bg3 }}; }
QCheckBox::indicator:checked {
    background: {{ accent_dim }};
    border: 1px solid {{ accent }};
    image: url({{ qss_check }});
}
QCheckBox::indicator:checked:hover { background: {{ accent }}; }
QCheckBox::indicator:disabled {
    background: {{ bg1 }};
    border-color: {{ line }};
}
QCheckBox::indicator:checked:disabled {
    background: {{ bg2 }};
    border-color: {{ line }};
    image: url({{ qss_check_disabled }});
}
QCheckBox#TopMiniChk { padding: {{ space_1 }}px {{ space_1h }}px; color: {{ fg1 }}; }
QRadioButton { color: {{ fg1 }}; spacing: {{ space_2 }}px; }
QRadioButton::indicator {
    width: {{ icon_md }}px; height: {{ icon_md }}px;
    border: 1px solid {{ fg0_25 }};
    border-radius: {{ radius_card }}px;
    background: {{ bg2 }};
}
QRadioButton::indicator:hover { border-color: {{ accent }}; }
QRadioButton::indicator:checked {
    background: {{ accent_dim }};
    border: 1px solid {{ accent }};
}
QRadioButton::indicator:disabled { background: {{ bg1 }}; border-color: {{ line }}; }

QSlider::groove:horizontal {
    background: {{ line }};
    height: {{ space_2 }}px;
    border-radius: {{ radius_sm }}px;
}
QSlider::handle:horizontal {
    background: {{ accent }};
    width: {{ icon_md }}px; height: {{ icon_md }}px;
    margin: -{{ space_1 }}px 0;
    border-radius: {{ radius_card }}px;
}
QSlider::sub-page:horizontal {
    background: {{ info }};
    border-radius: {{ radius_sm }}px;
}

QProgressBar {
    border: 1px solid {{ fg0_10 }};
    border-radius: {{ radius_ctl }}px;
    background: {{ fg0_08 }};
    height: {{ space_2 }}px;
    text-align: center;
    color: {{ fg1 }};
}
QProgressBar::chunk {
    border-radius: {{ radius_ctl }}px;
    background: {{ ok }};
}
QProgressBar#progress_main {
    border: none;
    border-radius: {{ radius_sm }}px;
    background: {{ fg0_08 }};
    height: {{ space_1h }}px;
    max-height: {{ space_1h }}px;
}
QProgressBar#progress_main::chunk { border-radius: {{ radius_sm }}px; margin: 0px; }
QProgressBar#progress_main[mode="sub"]::chunk { background: {{ info }}; }
QProgressBar#progress_main[mode="export"]::chunk { background: {{ ok }}; }
QProgressBar#progress_main[mode="bgm"]::chunk { background: {{ accent }}; }
QProgressBar#progress_main[mode="err"]::chunk { background: {{ err }}; }
QLabel#progLabel { color: {{ fg1 }}; font-size: {{ font_micro }}px; }
QLabel#progLabel[mode="sub"] { color: {{ info }}; font-weight: {{ w_semi }}; }
QLabel#progLabel[mode="export"] { color: {{ fg1 }}; }
QLabel#progLabel[mode="bgm"] { color: {{ accent }}; font-weight: {{ w_semi }}; }
QLabel#progLabel[mode="err"] { color: {{ err }}; font-weight: {{ w_semi }}; }

QScrollBar:vertical {
    background: {{ fg0_08 }};
    width: {{ space_2 }}px;
    margin: {{ space_quarter }}px;
    border-radius: {{ radius_ctl }}px;
}
QScrollBar::handle:vertical {
    background: {{ fg0_22 }};
    min-height: {{ control_h_lg }}px;
    border-radius: {{ radius_ctl }}px;
}
QScrollBar::handle:vertical:hover { background: {{ fg0_35 }}; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; width: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    height: {{ space_2 }}px;
    background: {{ fg0_08 }};
    border-radius: {{ radius_ctl }}px;
}
QScrollBar::handle:horizontal {
    background: {{ fg0_22 }};
    border-radius: {{ radius_ctl }}px;
    min-width: {{ space_5 + space_4 }}px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

QListWidget {
    background-color: {{ bg1 }};
    border: 1px solid {{ line }};
    color: {{ fg0 }};
    font-size: {{ font_body }}px;
    border-radius: {{ radius_card }}px;
}
QListWidget::item { padding: {{ space_1h }}px {{ space_2 }}px; border-radius: {{ radius_ctl }}px; }
QListWidget::item:selected {
    background: {{ accent_35 }};
    border: 1px solid {{ accent }};
    color: {{ fg0 }};
}
QListWidget::item:hover { background-color: {{ bg3 }}; }

QTreeWidget {
    background-color: {{ bg0 }};
    border: 1px solid {{ line }};
    border-radius: {{ radius_card }}px;
    color: {{ fg0 }};
    font-size: {{ font_body }}px;
    padding: {{ space_1h }}px;
    show-decoration-selected: 0;
    outline: none;
}
QTreeWidget::item { padding: {{ space_1h }}px; border-radius: {{ radius_ctl }}px; margin: {{ space_quarter }}px; }
QTreeWidget::item:selected {
    background: {{ accent_35 }};
    border: 1px solid {{ accent }};
    color: {{ fg0 }};
}
QTreeWidget::item:hover:!selected { background-color: {{ fg0_08 }}; }
QTreeWidget::indicator {
    width: {{ icon_md }}px; height: {{ icon_md }}px;
    border-radius: {{ radius_sm }}px;
    border: 1px solid {{ fg0_25 }};
    background: {{ bg2 }};
}
QTreeWidget::indicator:hover { border-color: {{ accent }}; }
QTreeWidget::indicator:checked {
    background: {{ accent_dim }};
    border: 1px solid {{ accent }};
    image: url({{ qss_check }});
}
