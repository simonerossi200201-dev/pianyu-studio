QScrollArea#welcomeScroll,
QWidget#welcomeViewport,
QWidget#welcomeScrollHost { background-color: {{ bg0 }}; border: none; }
QFrame#homeStitch {
    background-color: {{ bg1 }};
    border: 1px solid {{ line }};
    border-radius: {{ radius_card }}px;
}
QWidget#homeStitchMode QPushButton {
    background: {{ bg2 }};
    border: 1px solid {{ line }};
    border-radius: {{ radius_ctl }}px;
    padding: {{ space_1 }}px {{ space_2 }}px;
    min-height: {{ control_h }}px;
}
QWidget#homeStitchMode QPushButton:hover { background: {{ bg3 }}; border-color: {{ accent_dim }}; }
QWidget#homeStitchMode QPushButton:pressed { background: {{ accent_dim }}; }
QWidget#homeStitchMode QPushButton:checked {
    background: {{ accent_dim }};
    border: 1px solid {{ accent }};
    color: {{ fg0 }};
}
QWidget#homeStitchMode QPushButton:focus { border: 1px solid {{ accent }}; }
QWidget#homeStitchMode QPushButton:disabled { color: {{ fg_muted }}; background: {{ bg1 }}; }
QPushButton#homeStitchLink {
    background: transparent;
    border: none;
    color: {{ accent }};
    padding: 0px;
    min-height: {{ control_h }}px;
    font-weight: {{ w_medium }};
}
QPushButton#homeStitchLink:hover { color: {{ accent_hi }}; }
QPushButton#homeStitchLink:pressed { color: {{ accent_dim }}; }
QPushButton#homeStitchLink:focus { border: 1px solid {{ accent }}; }
QPushButton#homeStitchLink:disabled { color: {{ fg_muted }}; }
QFrame#welcomeCard {
    background: {{ bg1 }};
    border: 1px solid {{ line }};
    border-radius: {{ radius_card }}px;
    padding: {{ space_3 }}px;
}
