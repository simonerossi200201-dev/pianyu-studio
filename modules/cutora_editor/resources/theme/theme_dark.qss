}
QPushButton#homeStitchLink:hover { color: #E0BE68; }
QPushButton#homeStitchLink:pressed { color: #8A6E2E; }
QPushButton#homeStitchLink:focus { border: 1px solid #C8A24A; }
QPushButton#homeStitchLink:disabled { color: #7A6F63; }
QFrame#welcomeCard {
    background: #1C1815;
    border: 1px solid #524944;
    border-radius: 8px;
    padding: 12px;
}

/* four-state contract — generated by cutora.ui.theme.states */

QPushButton:hover { background-color: #262019; border-color: #8A6E2E; }
QPushButton:pressed { background-color: #241E18; }
QPushButton:focus { border-color: #C8A24A; }
QPushButton:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QToolButton:hover { background-color: #332A22; }
QToolButton:pressed { background-color: #241E18; }
QToolButton:focus { border-color: #C8A24A; }
QToolButton:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QSlider:hover { border-color: #C8A24A; }
QSlider:pressed { background-color: #241E18; }
QSlider:focus { border: 1px solid #C8A24A; }
QSlider:disabled { border-color: #524944; }

QCheckBox:hover { color: #EFE7DA; }
QCheckBox:pressed { background-color: #241E18; }
QCheckBox:focus { border: 1px solid #C8A24A; }
QCheckBox:disabled { color: #7A6F63; }

QRadioButton:hover { color: #EFE7DA; }
QRadioButton:pressed { background-color: #241E18; }
QRadioButton:focus { border: 1px solid #C8A24A; }
QRadioButton:disabled { color: #7A6F63; }

QLineEdit:hover { border-color: #C8A24A; }
QLineEdit:pressed { background-color: #241E18; }
QLineEdit:focus { border: 1px solid #C8A24A; }
QLineEdit:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QSpinBox:hover { border-color: #C8A24A; }
QSpinBox:pressed { background-color: #241E18; }
QSpinBox:focus { border: 1px solid #C8A24A; }
QSpinBox:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QDoubleSpinBox:hover { border-color: #C8A24A; }
QDoubleSpinBox:pressed { background-color: #241E18; }
QDoubleSpinBox:focus { border: 1px solid #C8A24A; }
QDoubleSpinBox:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QComboBox:hover { border-color: #C8A24A; }
QComboBox:pressed { background-color: #241E18; }
QComboBox:focus { border: 1px solid #C8A24A; }
QComboBox:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QTextEdit:hover { border-color: #C8A24A; }
QTextEdit:pressed { background-color: #241E18; }
QTextEdit:focus { border: 1px solid #C8A24A; }
QTextEdit:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QPlainTextEdit:hover { border-color: #C8A24A; }
QPlainTextEdit:pressed { background-color: #241E18; }
QPlainTextEdit:focus { border: 1px solid #C8A24A; }
QPlainTextEdit:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }

QToolButton#inspectorReset:hover { color: #EFE7DA; background: rgba(239, 231, 218, 0.100); }
QToolButton#inspectorReset:pressed { background-color: #241E18; }
QToolButton#inspectorReset:focus { border: 1px solid #C8A24A; }
QToolButton#inspectorReset:disabled { color: #7A6F63; background: transparent; border: none; }

QWidget#swatchBtn:hover { border: 1px solid #C8A24A; }
QWidget#swatchBtn:pressed { background-color: #241E18; }
QWidget#swatchBtn:focus { border: 1px solid #C8A24A; }
QWidget#swatchBtn:disabled { border-color: #7A6F63; }

QWidget#sectionToggle:hover { border: 1px solid #C8A24A; }
QWidget#sectionToggle:pressed { background-color: #241E18; }
QWidget#sectionToggle:focus { border: 1px solid #C8A24A; }
QWidget#sectionToggle:disabled { border-color: #7A6F63; }

QLabel:disabled,
QLabel#inspectorLabel:disabled,
QLabel#inspectorHex:disabled,
QWidget#dockSubContent QLabel:disabled {
    color: #7A6F63;
}

QSlider::groove:horizontal:disabled,
QWidget#dockSubContent QSlider::groove:horizontal:disabled {
    background: #524944;
}
QSlider::handle:horizontal:disabled,
QWidget#dockSubContent QSlider::handle:horizontal:disabled {
    background: #7A6F63;
}
QSlider::sub-page:horizontal:disabled,
QWidget#dockSubContent QSlider::sub-page:horizontal:disabled {
    background: #524944;
}

QToolButton:disabled { color: #7A6F63; background-color: #1C1815; border-color: #524944; }
