/* Studio Graphite / Roma — generated QSS. Tokens from cutora/ui/theme/tokens.py */

* {
    font-family: "Inter", "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
}

QMainWindow {
    background-color: #141210;
    color: #EFE7DA;
    font-size: 13px;
}
QMainWindow::separator {
    background: #141210;
    width: 8px;
    height: 8px;
    border: none;
}
QMainWindow::separator:hover {
    background: #C8A24A;
    border: 4px solid #141210;
}
QWidget#dockHandle {
    background: #141210;
    height: 4px;
    max-height: 4px;
    border: none;
}
QWidget#timelineFiller {
    background: #1C1815;
}
QWidget#GuardWindow {
    background-color: #1C1815;
    color: #EFE7DA;
}
QDialog, QMessageBox, QInputDialog, QFileDialog {
    background-color: #1C1815;
    color: #EFE7DA;
}
QLabel {
    color: #EFE7DA;
    font-weight: 400;
    background: transparent;
}
QLabel#hint, QLabel#formHint, QLabel#TopVolLabel, QLabel#TopIntroLabel, QLabel#sub {
    color: #B3A695;
    font-size: 12px;
}
QLabel#okHint { color: #7D9B6A; font-size: 12px; }
QLabel#warnHint { color: #C8913A; font-size: 12px; }
QLabel#errHint { color: #C2736B; font-size: 12px; }
QLabel#sectionHeader {
    color: #C8A24A;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 0;
}
QLabel#title { font-size: 17px; font-weight: 600; color: #EFE7DA; }
QLabel#pageTitle { font-size: 20px; font-weight: 600; color: #EFE7DA; }

QGroupBox {
    border: 1px solid #524944;
    margin-top: 8px;
    background-color: #1C1815;
    border-radius: 5px;
    color: #EFE7DA;
    padding: 8px 8px 8px 8px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 6px;
    color: #B3A695;
}
QGroupBox#bareGroup {
    border: none;
    margin: 0;
    padding: 2px 0;
    background: transparent;
}

QPushButton {
    background-color: #332A22;
    border: 1px solid #5D5550;
    border-radius: 5px;
    padding: 4px 8px;
    min-height: 22px;
    color: #EFE7DA;
    font-size: 12px;
    font-weight: 400;
}
QPushButton:hover { background-color: #262019; border-color: #8A6E2E; }
QPushButton:pressed { background-color: #8A6E2E; }
QPushButton:disabled { background-color: #1C1815; border: 1px solid #524944; color: #7A6F63; }
QPushButton#btn_ai, QPushButton#btn_exp, QPushButton#btn_batch_export,
QPushButton#btn_batch_ai, QPushButton#btnPrimary, QPushButton#btn_primary,
QPushButton#btn_apply_now {
    background-color: #8A6E2E;
    border: 1px solid #C8A24A;
    color: #EFE7DA;
    font-weight: 600;
    min-height: 28px;
}
QPushButton#btn_ai:hover, QPushButton#btn_exp:hover, QPushButton#btn_batch_export:hover,
QPushButton#btn_batch_ai:hover, QPushButton#btnPrimary:hover, QPushButton#btn_primary:hover,
QPushButton#btn_apply_now:hover { background-color: #C8A24A; }
QPushButton#btnSecondary {
    background-color: #262019;
    border: 1px solid #524944;
    color: #EFE7DA;
    font-weight: 400;
}
QPushButton#btnSecondary:hover { background-color: #332A22; border-color: #8A6E2E; }
QPushButton#btnSecondary:pressed { background-color: #8A6E2E; }
QPushButton#btn_exp_stop {
    background-color: #262019;
    border: 1px solid #524944;
    color: #EFE7DA;
}
QPushButton#btn_exp_stop:hover { background-color: #332A22; }
QPushButton#btnDanger {
    color: #B4544A;
    background: transparent;
    font-weight: 600;
    border: none;
    min-height: 22px;
    padding: 0;
}
QPushButton#TopMiniBtn, QPushButton#TopVolApply {
    height: 28px;
    min-height: 28px;
    padding: 4px 8px;
    border-radius: 8px;
    font-size: 12px;
}

QToolButton {
    background-color: rgba(239, 231, 218, 0.080);
    border: 1px solid rgba(239, 231, 218, 0.100);
    border-radius: 5px;
    padding: 4px;
    color: #EFE7DA;
}
QToolButton:hover { background-color: #332A22; }
QToolButton:pressed { background-color: #8A6E2E; }
QWidget#previewTools QToolButton {
    background: transparent;
    border: none;
    border-radius: 8px;
    padding: 0px;
}
QWidget#previewTools QToolButton:hover { background: rgba(239, 231, 218, 0.080); }
QWidget#previewTools QToolButton:pressed { background: #8A6E2E; }
QToolButton#stylepackEditBtn {
    background-color: rgba(20, 18, 16, 0.780);
    border: 1px solid rgba(239, 231, 218, 0.280);
    border-radius: 12px;
    padding: 2px;
    color: #EFE7DA;
}
QToolButton#stylepackEditBtn:hover {
    background-color: #332A22;
    border: 1px solid #C8A24A;
}
QToolButton#stylepackEditBtn:pressed { background-color: #8A6E2E; }

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QPlainTextEdit {
    background-color: #262019;
    color: #EFE7DA;
    border: 1px solid #5D5550;
    border-radius: 5px;
    padding: 4px 6px;
    selection-background-color: rgba(200, 162, 74, 0.350);
}
QLineEdit:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled,
QComboBox:disabled, QPlainTextEdit:disabled, QTextEdit:disabled {
    background-color: #1C1815;
    color: #7A6F63;
    border: 1px solid #524944;
}
QSpinBox, QDoubleSpinBox { padding-right: 16px; }
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    height: 12px;
    background: #332A22;
    border-left: 1px solid #524944;
    border-bottom: 1px solid #524944;
    border-top-right-radius: 5px;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    height: 12px;
    background: #332A22;
    border-left: 1px solid #524944;
    border-top: 1px solid #524944;
    border-bottom-right-radius: 5px;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #8A6E2E;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: #C8A24A;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(qss_chevron_up.svg);
    width: 8px; height: 8px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(qss_chevron_down.svg);
    width: 8px; height: 8px;
}
QTextEdit {
    background-color: #262019;
    color: #EFE7DA;
    border: 1px solid #5D5550;
    border-radius: 5px;
    padding: 6px 8px;
    selection-background-color: rgba(200, 162, 74, 0.350);
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #C8A24A;
}
QTextEdit#text_input {
    border: 1px solid rgba(239, 231, 218, 0.120);
    border-radius: 12px;
    background: rgba(239, 231, 218, 0.080);
    padding: 12px;
    color: #EFE7DA;
}
QPlainTextEdit, QTextEdit#mono {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
}
QPlainTextEdit#transcriptEditor {
    font-family: "Inter", "Noto Sans SC", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
    font-size: 13px;
}
QComboBox { padding-right: 24px; }
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    border-radius: 0;
    background: transparent;
}
QComboBox::drop-down:hover,
QComboBox::drop-down:disabled {
    border: none;
    background: transparent;
}
QComboBox::down-arrow {
    image: url(qss_chevron_down.svg);
    width: 8px;
    height: 8px;
}
QComboBox QAbstractItemView {
    background: #1C1815;
    color: #EFE7DA;
    border: 1px solid #524944;
    selection-background-color: rgba(200, 162, 74, 0.350);
    outline: 0;
}
QComboBox QAbstractItemView::item { padding: 4px 8px; }

QTabWidget::pane {
    background-color: #1C1815;
    border: none;
    border-radius: 0;
}
QTabBar::tab {
    background-color: #262019;
    color: #B3A695;
    padding: 6px 12px;
    border: 1px solid #524944;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
}
QTabBar::tab:selected {
    background-color: #332A22;
    color: #EFE7DA;
    border-bottom: 2px solid #C8A24A;
}
QTabWidget QWidget { background-color: #1C1815; color: #EFE7DA; }

QSplitter::handle { background: rgba(239, 231, 218, 0.080); }
QSplitter::handle:vertical { height: 6px; margin: 0px 8px; border-radius: 3px; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:hover { background: rgba(239, 231, 218, 0.160); }
/* Q106: 首页三栏的分隔条平时完全看不见，鼠标悬上去才现出一条细金线。
   句柄仍有 space_3 的宽度好抓；左右各收 space_1、上下各收 space_6，
   于是亮出来的只是一条又细又短的圆头小线，不是一整条粗亮竖条。 */
/* Q126：选中文本时浮在预览上方的工具条 */
QFrame#textContextBar {
    background-color: #1C1815;
    border: 1px solid rgba(239, 231, 218, 0.280);
    border-radius: 8px;
}
QFrame#textContextBar QSpinBox, QFrame#textContextBar QDoubleSpinBox,
QFrame#textContextBar QComboBox {
    /* 和右侧面板同一个高度权威：内容 insp_ctl_inner + 1px 边框 x2 */
    min-height: 26px;
    max-height: 26px;
    padding-top: 0; padding-bottom: 0;
}
/* Q170：字体选择器弹窗（每个字体用自己的字形显示，后台渲染） */
QFrame#fontPicker {
    background-color: #1C1815;
    border: 1px solid rgba(239, 231, 218, 0.280);
    border-radius: 8px;
}
QFrame#fontPicker QLineEdit#fontPickerSearch {
    background: #262019;
    border: none;
    border-bottom: 1px solid #524944;
    border-radius: 0;
    padding: 8px 12px;
    min-height: 28px;
    color: #EFE7DA;
    font-size: 13px;
}
QFrame#fontPicker QListView#fontPickerList {
    background: #1C1815;
    border: none;
    outline: none;
}
QFrame#fontPicker QListView#fontPickerList::item { border: none; padding: 0; }
QFrame#fontPicker QListView#fontPickerList::item:selected { background: transparent; }
QFrame#fontPicker QListView#fontPickerList::item:hover { background: transparent; }
/* Q152-A / F 关键帧编辑器、节点编辑器工具条：平铺按钮，选中态用金色 */
QWidget#keyframeEditor, QWidget#nodeEditor { background: #1C1815; }
QWidget#keyframeEditor QToolButton, QWidget#nodeEditor QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 2px 8px;
    color: #B3A695;
}
QWidget#keyframeEditor QToolButton:hover, QWidget#nodeEditor QToolButton:hover { background: rgba(239, 231, 218, 0.080); color: #EFE7DA; }
QWidget#keyframeEditor QToolButton:pressed, QWidget#nodeEditor QToolButton:pressed { background: #8A6E2E; }
QWidget#keyframeEditor QToolButton:checked, QWidget#nodeEditor QToolButton:checked {
    background: rgba(239, 231, 218, 0.080);
    border-color: #C8A24A;
    color: #EFE7DA;
}
QWidget#keyframeEditor QToolButton:disabled, QWidget#nodeEditor QToolButton:disabled { color: #7A6F63; }
QFrame#textContextBar QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px;
}
QFrame#textContextBar QToolButton:hover { background: rgba(239, 231, 218, 0.080); }
QFrame#textContextBar QToolButton:checked {
    background: #8A6E2E;
    border-color: #C8A24A;
}
QFrame#textContextBar QFrame#ctxSep {
    background: rgba(239, 231, 218, 0.280);
    border: none;
    margin: 0 4px;
}
QFrame#textContextBar QLabel#ctxLabel { color: #92897F; padding-left: 4px; }

/* Q127：画布上所见即所得的隐形编辑框 —— 字由 textfx 画，它自己什么都不显示 */
QTextEdit#canvasTextEditor, QTextEdit#canvasTextEditor QWidget {
    background: transparent;
    border: none;
    color: transparent;
    selection-background-color: transparent;
    selection-color: transparent;
}

/* Q128：文本样式画廊（弹出层） */
QFrame#textStyleGallery {
    background-color: #1C1815;
    border: 1px solid rgba(239, 231, 218, 0.280);
    border-radius: 8px;
}
QFrame#textStyleGallery QLabel#ctxLabel { color: #B3A695; font-weight: 600; }
QFrame#textStyleGallery QListWidget#textStyleList {
    background: transparent;
    border: none;
    color: #B3A695;
}
QFrame#textStyleGallery QListWidget#textStyleList::item {
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 4px;
}
QFrame#textStyleGallery QListWidget#textStyleList::item:hover { background: rgba(239, 231, 218, 0.080); }
QFrame#textStyleGallery QListWidget#textStyleList::item:selected {
    background: #8A6E2E;
    border-color: #C8A24A;
}

/* Q191 房间：卡片之间的分隔条平时看不见，鼠标经过才亮一道细线（同主界面的停靠分隔） */
QSplitter#roomSplit::handle { background: transparent; border: none; }
QSplitter#roomSplit::handle:horizontal { width: 12px; }
QSplitter#roomSplit::handle:vertical { height: 12px; }
QSplitter#roomSplit::handle:horizontal:hover,
QSplitter#roomSplit::handle:horizontal:pressed {
    background-color: #C8A24A;
    margin: 32px 6px 32px 4px;
}
QSplitter#roomSplit::handle:vertical:hover,
QSplitter#roomSplit::handle:vertical:pressed {
    background-color: #C8A24A;
    margin: 4px 32px 6px 32px;
}
QFrame#roomCard {
    background-color: #1C1815;
    border: 1px solid rgba(239, 231, 218, 0.080);
    border-radius: 8px;
}
QFrame#roomCard QScrollArea, QFrame#roomCard QScrollArea > QWidget > QWidget { background: transparent; }
/* Q192 主窗口里的浮层 / 侧滑面板（原来的独立弹窗） */
QFrame#sheetCard {
    background-color: #1C1815;
    border: 1px solid rgba(239, 231, 218, 0.100);
    border-radius: 12px;
}
QLabel#sheetTitle { color: #EFE7DA; font-weight: 600; font-size: 13px; }
QPushButton#sheetClose {
    background: transparent;
    border: none;
    color: #B3A695;
    border-radius: 5px;
    padding: 0px;
    min-height: 0px;
    min-width: 0px;
}
QPushButton#sheetClose:hover { background: rgba(239, 231, 218, 0.100); color: #EFE7DA; }
QToolBar#pageBar { background: #141210; border: none; padding: 0px; spacing: 0px; margin: 0px; }
QTableWidget#batchTextTable { border-radius: 8px; }
QTableWidget#batchTextTable QHeaderView::section:horizontal:first { border-top-left-radius: 8px; }
QTableWidget#batchTextTable QHeaderView::section:horizontal:last { border-top-right-radius: 8px; border-right: none; }

QSplitter#welcomeSplit::handle { background: transparent; border: none; }
QSplitter#welcomeSplit::handle:horizontal { width: 12px; }
QSplitter#welcomeSplit::handle:horizontal:hover,
QSplitter#welcomeSplit::handle:horizontal:pressed {
    background-color: #C8A24A;
    margin: 32px 4px;
    border-radius: 3px;
}

QCheckBox { color: #B3A695; spacing: 8px; }
QCheckBox::indicator {
    width: 14px; height: 14px;
    border: 1px solid rgba(239, 231, 218, 0.250);
    border-radius: 3px;
    background: #262019;
}
QCheckBox::indicator:hover { border-color: #C8A24A; background: #332A22; }
QCheckBox::indicator:checked {
    background: #8A6E2E;
    border: 1px solid #C8A24A;
    image: url(qss_check.svg);
}
QCheckBox::indicator:checked:hover { background: #C8A24A; }
QCheckBox::indicator:disabled {
    background: #1C1815;
    border-color: #524944;
}
QCheckBox::indicator:checked:disabled {
    background: #262019;
    border-color: #524944;
    image: url(qss_check_disabled.svg);
}
QCheckBox#TopMiniChk { padding: 4px 6px; color: #B3A695; }
QRadioButton { color: #B3A695; spacing: 8px; }
QRadioButton::indicator {
    width: 16px; height: 16px;
    border: 1px solid rgba(239, 231, 218, 0.250);
    border-radius: 8px;
    background: #262019;
}
QRadioButton::indicator:hover { border-color: #C8A24A; }
QRadioButton::indicator:checked {
    background: #8A6E2E;
    border: 1px solid #C8A24A;
}
QRadioButton::indicator:disabled { background: #1C1815; border-color: #524944; }

QSlider::groove:horizontal {
    background: #524944;
    height: 8px;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #C8A24A;
    width: 16px; height: 16px;
    margin: -4px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #8FA89B;
    border-radius: 3px;
}

QProgressBar {
    border: 1px solid rgba(239, 231, 218, 0.100);
    border-radius: 5px;
    background: rgba(239, 231, 218, 0.080);
    height: 8px;
    text-align: center;
    color: #B3A695;
}
QProgressBar::chunk {
    border-radius: 5px;
    background: #7D9B6A;
}
QProgressBar#progress_main {
    border: none;
    border-radius: 3px;
    background: rgba(239, 231, 218, 0.080);
    height: 6px;
    max-height: 6px;
}
QProgressBar#progress_main::chunk { border-radius: 3px; margin: 0px; }
QProgressBar#progress_main[mode="sub"]::chunk { background: #8FA89B; }
QProgressBar#progress_main[mode="export"]::chunk { background: #7D9B6A; }
QProgressBar#progress_main[mode="bgm"]::chunk { background: #C8A24A; }
QProgressBar#progress_main[mode="err"]::chunk { background: #B4544A; }
QLabel#progLabel { color: #B3A695; font-size: 11px; }
QLabel#progLabel[mode="sub"] { color: #8FA89B; font-weight: 600; }
QLabel#progLabel[mode="export"] { color: #B3A695; }
QLabel#progLabel[mode="bgm"] { color: #C8A24A; font-weight: 600; }
QLabel#progLabel[mode="err"] { color: #B4544A; font-weight: 600; }

QScrollBar:vertical {
    background: rgba(239, 231, 218, 0.080);
    width: 8px;
    margin: 2px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: rgba(239, 231, 218, 0.220);
    min-height: 28px;
    border-radius: 5px;
}
QScrollBar::handle:vertical:hover { background: rgba(239, 231, 218, 0.350); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; width: 0px; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal {
    height: 8px;
    background: rgba(239, 231, 218, 0.080);
    border-radius: 5px;
}
QScrollBar::handle:horizontal {
    background: rgba(239, 231, 218, 0.220);
    border-radius: 5px;
    min-width: 40px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }

QListWidget {
    background-color: #1C1815;
    border: 1px solid #524944;
    color: #EFE7DA;
    font-size: 13px;
    border-radius: 8px;
}
QListWidget::item { padding: 6px 8px; border-radius: 5px; }
QListWidget::item:selected {
    background: rgba(200, 162, 74, 0.350);
    border: 1px solid #C8A24A;
    color: #EFE7DA;
}
QListWidget::item:hover { background-color: #332A22; }

QTreeWidget {
    background-color: #141210;
    border: 1px solid #524944;
    border-radius: 8px;
    color: #EFE7DA;
    font-size: 13px;
    padding: 6px;
    show-decoration-selected: 0;
    outline: none;
}
QTreeWidget::item { padding: 6px; border-radius: 5px; margin: 2px; }
QTreeWidget::item:selected {
    background: rgba(200, 162, 74, 0.350);
    border: 1px solid #C8A24A;
    color: #EFE7DA;
}
QTreeWidget::item:hover:!selected { background-color: rgba(239, 231, 218, 0.080); }
QTreeWidget::indicator {
    width: 16px; height: 16px;
    border-radius: 3px;
    border: 1px solid rgba(239, 231, 218, 0.250);
    background: #262019;
}
QTreeWidget::indicator:hover { border-color: #C8A24A; }
QTreeWidget::indicator:checked {
    background: #8A6E2E;
    border: 1px solid #C8A24A;
    image: url(qss_check.svg);
}
QTreeWidget::indicator:checked:hover { background: #C8A24A; }
QTreeWidget::indicator:disabled { background: #1C1815; border-color: #524944; }
QTreeWidget::indicator:checked:disabled { image: url(qss_check_disabled.svg); }

QTableWidget, QTableView, QTreeView, QListView {
    background-color: #1C1815;
    color: #EFE7DA;
    gridline-color: #524944;
    border: 1px solid #524944;
    border-radius: 5px;
    alternate-background-color: #262019;
    selection-background-color: #8A6E2E;
    selection-color: #EFE7DA;
    outline: 0;
}
QTableView::viewport, QTableWidget::viewport,
QTreeView::viewport, QTreeWidget::viewport,
QListView::viewport, QListWidget::viewport {
    background-color: #1C1815;
    color: #EFE7DA;
}
QTableWidget::item:selected, QTableView::item:selected,
QTreeView::item:selected, QTreeWidget::item:selected,
QListView::item:selected, QListWidget::item:selected {
    background: #8A6E2E;
    color: #EFE7DA;
}
QTableWidget::item:hover, QTableView::item:hover,
QTreeView::item:hover, QTreeWidget::item:hover,
QListView::item:hover, QListWidget::item:hover {
    background: #332A22;
}
QHeaderView {
    background-color: #262019;
    color: #EFE7DA;
}
QHeaderView::section,
QHeaderView::section:horizontal,
QHeaderView::section:vertical {
    background-color: #262019;
    color: #EFE7DA;
    padding: 6px 8px;
    border: none;
    border-right: 1px solid #524944;
    border-bottom: 1px solid #524944;
    font-weight: 600;
}
QTableView QTableCornerButton::section,
QTableWidget QTableCornerButton::section,
QTableCornerButton::section {
    background-color: #262019;
    border: none;
    border-right: 1px solid #524944;
    border-bottom: 1px solid #524944;
}

QMenuBar {
    background: #141210;
    color: #EFE7DA;
    padding: 2px 6px;
}
QMenuBar::item { background: transparent; padding: 4px 8px; border-radius: 5px; }
QMenuBar::item:selected { background: rgba(239, 231, 218, 0.100); }
QMenu {
    background: #1C1815;
    color: #EFE7DA;
    border: 1px solid #524944;
    border-radius: 8px;
    padding: 6px;
}
QMenu::item { padding: 6px 16px; border-radius: 8px; }
QMenu::item:selected { background: rgba(200, 162, 74, 0.180); }
QMenu::separator { height: 1px; background: rgba(239, 231, 218, 0.080); margin: 6px 8px; }
QMenu::item:disabled { color: #7A6F63; }

QStatusBar { background: #141210; color: #B3A695; }
QLabel#statusSep { color: #524944; padding: 0 8px; background: transparent; }
QWidget#dockHandle { background: #141210; border: none; }
QWidget#TimelineContainer { background: #141210; border: none; }
QWidget#previewTools { background: #141210; border: none; }
QToolTip {
    background: #262019;
    color: #EFE7DA;
    border: 1px solid #524944;
    padding: 4px 8px;
    border-radius: 3px;
}
QDialogButtonBox QPushButton { min-width: 72px; }
QLabel#timelineTotal {
    color: #B3A695;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    padding: 0 8px;
    background: transparent;
}
QLabel#transportTimecode {
    color: #B3A695;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 12px;
    padding: 0 8px;
    background: transparent;
}

#previewWrap { background: #141210; border: none; border-radius: 0; padding: 0px; margin: 0px; }
#previewWrap QFrame, #previewWrap QWidget { background: transparent; border: none; }
QWidget#VideoCanvas { background-color: #141210; }
QTextEdit#MultiGridTextEdit {
    background: rgba(239, 231, 218, 0.080);
    color: #EFE7DA;
    border: 1px solid rgba(239, 231, 218, 0.140);
    border-radius: 5px;
    padding: 4px;
}
QLabel#gridCaption { color: #B3A695; font-size: 11px; font-weight: 600; }
QScrollArea#multiTextScroll { border: none; background: transparent; }
QWidget#multiTextContainer { background: transparent; }
QFrame#vDivider { color: #524944; }

#TopBar { background: #141210; }
#TopBar QMenuBar { background: transparent; color: #EFE7DA; }
#TopBar QMenuBar::item { background: transparent; padding: 4px 8px; margin: 2px; border-radius: 8px; }
#TopBar QMenuBar::item:selected { background: rgba(239, 231, 218, 0.100); }
#TopBar QPushButton {
    background: transparent;
    border: none;
    color: #B3A695;
    padding: 4px 8px;
    margin: 2px;
    border-radius: 8px;
}
#TopBar QPushButton:hover { background: rgba(239, 231, 218, 0.100); color: #EFE7DA; }
#TopBar QPushButton:pressed { background: rgba(239, 231, 218, 0.140); }
#TopBar QCheckBox { background: transparent; border: none; color: #B3A695; padding: 4px 8px; margin: 2px; border-radius: 8px; }
#TopBar QCheckBox:hover { background: rgba(239, 231, 218, 0.100); color: #EFE7DA; }
#TopBar QCheckBox::indicator { width: 12px; height: 12px; border-radius: 3px; border: 1px solid rgba(239, 231, 218, 0.220); background: rgba(239, 231, 218, 0.080); margin-right: 6px; }
#TopBar QCheckBox::indicator:hover { border-color: #C8A24A; }
#TopBar QCheckBox::indicator:checked { background: #8A6E2E; border: 1px solid #C8A24A; image: url(qss_check.svg); }
#TopBar QCheckBox::indicator:checked:hover { background: #C8A24A; }
#TopBar QCheckBox::indicator:disabled { background: #1C1815; border-color: #524944; }
#TopBar QCheckBox::indicator:checked:disabled { image: url(qss_check_disabled.svg); }
#TopBar QPushButton#btn_batch_intro {
    background: #262019;
    color: #EFE7DA;
    border: 1px solid #524944;
    border-radius: 5px;
    padding: 4px 8px;
    font-weight: 600;
    font-size: 12px;
}
#TopBar QPushButton#btn_batch_intro:hover { background: #332A22; border-color: #8A6E2E; }
#TopBar QPushButton#btn_batch_intro::menu-indicator { width: 0px; height: 0px; }
#TopBar QDoubleSpinBox#TopVolSpin, #TopBar QDoubleSpinBox#TopIntroSpin {
    background: rgba(239, 231, 218, 0.080);
    color: #B3A695;
    font-size: 12px;
    border: 1px solid rgba(239, 231, 218, 0.120);
    border-radius: 5px;
    padding: 2px 24px 2px 6px;
    min-width: 88px;
}
#TopBar QDoubleSpinBox#TopIntroSpin:hover { background: rgba(239, 231, 218, 0.120); }
#btn_track_share:hover, #btn_export:hover, #btn_settings:hover, #btn_theme:hover, #btn_mini:hover {
    background-color: rgba(239, 231, 218, 0.100);
}

#PropertyPanel { background: #1C1815; }
#PropertyPanel QScrollArea, #PropertyPanel QScrollArea > QWidget { background: transparent; border: none; }
#PropertyPanel QWidget#propPanelContainer { background: transparent; }
#PropertyPanel QLabel { color: #EFE7DA; font-size: 12px; font-weight: 400; }
#PropertyPanel QGroupBox {
    border: 1px solid rgba(239, 231, 218, 0.100);
    border-radius: 12px;
    margin-top: 12px;
    padding: 16px 12px 12px 12px;
    background: rgba(239, 231, 218, 0.080);
}
#PropertyPanel QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 2px 8px;
    color: #C8A24A;
    font-weight: 600;
    background: rgba(200, 162, 74, 0.180);
    border-radius: 5px;
}
#PropertyPanel QSpinBox, #PropertyPanel QDoubleSpinBox,
#PropertyPanel QComboBox, #PropertyPanel QLineEdit {
    background: #262019;
    color: #EFE7DA;
    border: 1px solid rgba(239, 231, 218, 0.160);
    border-radius: 5px;
    /* box model: content 26 + 1px border x2 = 28 */
    padding: 0px 8px;
    min-height: 26px;
    max-height: 26px;
}
#PropertyPanel QSpinBox:hover, #PropertyPanel QDoubleSpinBox:hover,
#PropertyPanel QComboBox:hover, #PropertyPanel QLineEdit:hover {
    border: 1px solid rgba(239, 231, 218, 0.250);
}
#PropertyPanel QSpinBox#geomSpin {
    padding: 0px 4px 0px 6px;
    min-height: 26px;
    max-height: 26px;
}
#PropertyPanel QSpinBox:focus, #PropertyPanel QDoubleSpinBox:focus,
#PropertyPanel QComboBox:focus, #PropertyPanel QLineEdit:focus {
    border: 1px solid #C8A24A;
}
#PropertyPanel QComboBox::drop-down {
    width: 20px;
    border: none;
    border-radius: 0;
    background: transparent;
}
#PropertyPanel QComboBox QAbstractItemView {
    background: #1C1815;
    color: #EFE7DA;
    selection-background-color: rgba(200, 162, 74, 0.350);
    outline: 0;
}
#PropertyPanel QTextEdit {
    background: #262019;
    color: #EFE7DA;
    border: 1px solid rgba(239, 231, 218, 0.160);
    border-radius: 8px;
    padding: 8px 8px;
    height: 64px;
}
#PropertyPanel QCheckBox { color: #EFE7DA; spacing: 6px; font-size: 12px; }
#PropertyPanel QCheckBox::indicator {
    width: 16px; height: 16px; border-radius: 3px;
    border: 1px solid rgba(239, 231, 218, 0.250); background: #262019;
}
#PropertyPanel QCheckBox::indicator:hover { border-color: #C8A24A; background: #332A22; }
#PropertyPanel QCheckBox::indicator:checked {
    background: #8A6E2E; border: 1px solid #C8A24A; image: url(qss_check.svg);
}
#PropertyPanel QCheckBox::indicator:checked:hover { background: #C8A24A; }
#PropertyPanel QCheckBox::indicator:disabled { background: #1C1815; border-color: #524944; }
#PropertyPanel QCheckBox::indicator:checked:disabled { image: url(qss_check_disabled.svg); }
#PropertyPanel QPushButton {
    background: rgba(239, 231, 218, 0.080);
    border: 1px solid rgba(239, 231, 218, 0.140);
    color: #EFE7DA;
    padding: 0px 12px;
    min-height: 26px;
    max-height: 26px;
    border-radius: 5px;
}
#PropertyPanel QPushButton:hover { background: rgba(239, 231, 218, 0.120); border-color: rgba(239, 231, 218, 0.220); }
#SubtitleStylePanel QToolButton#presetMenuBtn {
    background: rgba(239, 231, 218, 0.080);
    border: 1px solid rgba(239, 231, 218, 0.160);
    border-radius: 5px;
    min-height: 26px;
    min-width: 26px;
    max-height: 26px;
    max-width: 26px;
    padding: 0px;
}
#PropertyPanel QToolButton#propMenuBtn {
    background: rgba(239, 231, 218, 0.080);
    border: 1px solid rgba(239, 231, 218, 0.160);
    border-radius: 5px;
    min-height: 26px;
    min-width: 84px;
    max-height: 26px;
    padding: 0px 8px;
}
#PropertyPanel QToolButton#propMenuBtn::menu-indicator,
#SubtitleStylePanel QToolButton#presetMenuBtn::menu-indicator {
    image: none;
    width: 0px;
}
#PropertyPanel QSlider::groove:horizontal { background: rgba(239, 231, 218, 0.160); height: 8px; border-radius: 3px; }
#PropertyPanel QSlider::handle:horizontal {
    background: #C8A24A; width: 16px; height: 16px; margin: -4px 0; border-radius: 8px;
}
#PropertyPanel QSlider::sub-page:horizontal { background: #C8A24A; border-radius: 3px; }

#SubtitleStylePanel QWidget#packEditBar {
    background-color: #262019;
    border: 1px solid #8A6E2E;
    border-radius: 5px;
    margin: 8px 8px 4px 8px;
}
#SubtitleStylePanel QWidget#packEditBar QLabel {
    color: #C8A24A;
    font-weight: 600;
}

QWidget#dockSubContent { background-color: #1C1815; color: #EFE7DA; border: none; }
QWidget#dockSectionHeader { background: transparent; border: none; border-top: 1px solid rgba(239, 231, 218, 0.080); }
QLabel#dockSectionArrow {
    color: #92897F; font-size: 13px;
    padding: 0; background: transparent; border: none;
}
QWidget#dockSectionContent { background: transparent; }
QWidget#dockSubContent QLabel {
    color: #B3A695; font-size: 12px; padding: 1px 0;
    background: transparent; border: none; font-weight: 400;
}
QWidget#dockSubContent QLabel#dockSectionTitle,
QLabel#dockSectionTitle {
    color: #EFE7DA; font-size: 15px; font-weight: 600;
    padding: 0; background: transparent; border: none;
}
QWidget#dockSubContent QLabel#inspectorLabel,
QLabel#inspectorLabel {
    color: #B3A695; font-size: 12px;
    background: transparent; border: none; padding: 0;
}
QWidget#dockSubContent QSpinBox, QWidget#dockSubContent QDoubleSpinBox, QWidget#dockSubContent QComboBox {
    background: #262019; color: #EFE7DA; border: 1px solid #524944;
    border-radius: 5px; padding: 0px 8px; font-size: 12px;
    min-height: 26px; max-height: 26px;
}
QWidget#dockSubContent QSpinBox:hover, QWidget#dockSubContent QDoubleSpinBox:hover,
QWidget#dockSubContent QComboBox:hover { border: 1px solid rgba(239, 231, 218, 0.250); }
QWidget#dockSubContent QSpinBox:focus, QWidget#dockSubContent QDoubleSpinBox:focus,
QWidget#dockSubContent QComboBox:focus { border: 1px solid #C8A24A; }
QWidget#dockSubContent QComboBox QAbstractItemView {
    background: #1C1815; color: #EFE7DA; border: 1px solid #524944;
    selection-background-color: rgba(200, 162, 74, 0.350); outline: 0;
}
QWidget#dockSubContent QSlider::groove:horizontal { background: #524944; height: 8px; border-radius: 3px; }
QWidget#dockSubContent QSlider::handle:horizontal {
    background: #C8A24A; width: 16px; height: 16px; margin: -4px 0; border-radius: 8px;
}
QWidget#dockSubContent QSlider::sub-page:horizontal { background: #C8A24A; border-radius: 3px; }
QWidget#dockSubContent QSpinBox:disabled, QWidget#dockSubContent QDoubleSpinBox:disabled,
QWidget#dockSubContent QComboBox:disabled,
QWidget#dockSubContent QLineEdit:disabled {
    background: #1C1815; color: #7A6F63; border: 1px solid #524944;
    selection-background-color: #1C1815; selection-color: #7A6F63;
}
QWidget#dockSubContent QLabel:disabled { color: #7A6F63; }
QWidget#dockSubContent QPushButton:disabled {
    background: #1C1815; color: #7A6F63; border: 1px solid #524944;
}
QWidget#dockSubContent QCheckBox:disabled { color: #7A6F63; }
QWidget#dockSubContent QSlider::handle:horizontal:disabled { background: #7A6F63; }
QWidget#dockSubContent QSlider::sub-page:horizontal:disabled { background: #524944; }
QWidget#dockSubContent QSlider::groove:horizontal:disabled { background: #1C1815; }

QToolButton#inspectorIconBtn, QToolButton#aspectLockBtn {
    background: transparent; border: 1px solid transparent; border-radius: 5px;
    padding: 0px;
    min-width: 26px; max-width: 26px;
    min-height: 26px; max-height: 26px;
}
QToolButton#inspectorIconBtn:hover, QToolButton#aspectLockBtn:hover {
    background: rgba(239, 231, 218, 0.080); border: 1px solid rgba(239, 231, 218, 0.160);
}
QToolButton#inspectorIconBtn:pressed, QToolButton#aspectLockBtn:pressed { background: rgba(239, 231, 218, 0.120); }
QToolButton#inspectorIconBtn:checked, QToolButton#aspectLockBtn:checked {
    background: rgba(200, 162, 74, 0.180); border: 1px solid #8A6E2E;
}
QToolButton#inspectorIconBtn::menu-indicator { image: none; width: 0px; }
QToolButton#inspectorIconBtn:focus, QToolButton#aspectLockBtn:focus { border: 1px solid #C8A24A; }
QToolButton#inspectorIconBtn:disabled, QToolButton#aspectLockBtn:disabled { background: transparent; border: 1px solid transparent; }
QWidget#segmented {
    background: #262019; border: 1px solid rgba(239, 231, 218, 0.160); border-radius: 5px;
}
QWidget#segmented QToolButton#segBtn {
    background: transparent; border: none; border-radius: 3px; padding: 0px;
    min-height: 26px; max-height: 26px;
}
QWidget#segmented QToolButton#segBtn:hover { background: rgba(239, 231, 218, 0.080); }
QWidget#segmented QToolButton#segBtn:pressed { background: rgba(239, 231, 218, 0.120); }
QWidget#segmented QToolButton#segBtn:checked { background: rgba(200, 162, 74, 0.180); }
QWidget#segmented QToolButton#segBtn:focus { background: rgba(239, 231, 218, 0.100); }
QWidget#segmented QToolButton#segBtn:disabled { background: transparent; }
QToolButton#chipBtn {
    background: #262019; color: #B3A695; border: 1px solid rgba(239, 231, 218, 0.160);
    border-radius: 5px; padding: 0px 4px; font-size: 12px;
    min-height: 26px; max-height: 26px;
}
QToolButton#chipBtn:hover { border: 1px solid rgba(239, 231, 218, 0.250); color: #EFE7DA; }
QToolButton#chipBtn:pressed { background: rgba(239, 231, 218, 0.120); }
QToolButton#chipBtn:checked { background: rgba(200, 162, 74, 0.180); border: 1px solid #8A6E2E; color: #EFE7DA; }
QToolButton#chipBtn:focus { border: 1px solid #C8A24A; }
QToolButton#chipBtn:disabled { background: #1C1815; color: #7A6F63; border: 1px solid #524944; }
QWidget#inspectorRow { background: transparent; }
QLabel#inspectorLabel {
    color: #B3A695; font-size: 12px;
    background: transparent; border: none; padding: 0;
}
QLabel#inspectorHex {
    color: #92897F; font-size: 12px;
    font-family: "JetBrains Mono", monospace;
    background: transparent; border: none; padding: 0 6px;
}
QToolButton#inspectorReset {
    color: #92897F; background: transparent; border: none;
    font-size: 15px; padding: 0;
    min-width: 20px; max-width: 20px;
    max-height: 20px;
}
QToolButton#inspectorReset:hover { color: #EFE7DA; background: rgba(239, 231, 218, 0.100); border-radius: 5px; }
QWidget#inspectorSliderSpin QSpinBox, QWidget#inspectorSliderSpin QDoubleSpinBox {
    min-width: 38px; max-width: 38px;
}
QWidget#dockSubContent QCheckBox { color: #B3A695; spacing: 6px; font-size: 12px; }
QWidget#dockSubContent QCheckBox::indicator {
    width: 14px; height: 14px; border-radius: 3px; border: 1px solid #524944; background: #262019;
}
QWidget#dockSubContent QCheckBox::indicator:hover { border-color: #C8A24A; background: #332A22; }
QWidget#dockSubContent QCheckBox::indicator:checked {
    background: #8A6E2E; border: 1px solid #C8A24A; image: url(qss_check.svg);
}
QWidget#dockSubContent QCheckBox::indicator:checked:hover { background: #C8A24A; }
QWidget#dockSubContent QCheckBox::indicator:disabled { background: #1C1815; border-color: #524944; }
QWidget#dockSubContent QCheckBox::indicator:checked:disabled { image: url(qss_check_disabled.svg); }
QWidget#dockSubContent QPushButton {
    background: #262019; color: #B3A695; border: 1px solid #524944;
    border-radius: 5px; padding: 0px 12px; font-size: 12px;
    min-height: 26px; max-height: 26px;
}
QWidget#dockSubContent QPushButton:hover { background: #332A22; border: 1px solid #C8A24A; color: #EFE7DA; }
QWidget#dockSubContent QGroupBox {
    border: 1px solid #524944; border-radius: 5px;
    margin-top: 8px; padding: 12px 6px 6px 6px; font-size: 11px; color: #B3A695;
}
QWidget#dockSubContent QGroupBox::title {
    subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #8FA89B; font-weight: 600;
}
QPushButton#dockToggleDot {
    background: #524944; border-radius: 5px; border: none;
    min-width: 12px; max-width: 12px; height: 12px; max-height: 12px;
}
QPushButton#dockToggleDot[on="true"] { background: #B4544A; }

KeywordRuleRow {
    border: 1px solid #524944;
    border-radius: 3px;
    background: #262019;
    margin-bottom: 2px;
}

QFrame#ErrorBanner {
    background: #B4544A;
    color: #EFE7DA;
    border: none;
}
QLabel#ErrorBannerLabel { color: #EFE7DA; font-size: 12px; background: transparent; }
QPushButton#ErrorBannerClose {
    color: #EFE7DA;
    background: transparent;
    border: none;
    font-weight: 600;
    min-width: 24px;
    min-height: 24px;
}

QWidget#GuardWindow { background: #1C1815; color: #EFE7DA; }
QWidget#GuardWindow QLabel#hint { color: #C8913A; }
QWidget#GuardWindow[done="true"] QLabel#hint { color: #7D9B6A; }
QWidget#GuardWindow QProgressBar::chunk { background: #8FA89B; }
QWidget#GuardWindow[done="true"] QProgressBar::chunk { background: #7D9B6A; }

QMessageBox QLabel { color: #EFE7DA; font-weight: 400; }
QMessageBox QPushButton { min-width: 64px; min-height: 24px; padding: 6px 16px; }
QMessageBox QPushButton:default { background-color: #8A6E2E; border: 1px solid #C8A24A; }
QMessageBox QPushButton:default:hover { background-color: #C8A24A; }

QFileDialog QTreeView, QFileDialog QListView {
    background-color: #1C1815;
