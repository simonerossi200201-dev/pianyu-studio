<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>片语 Studio 使用说明</title>
<style>
:root{
  --paper:#f7f7f5; --panel:#ffffff; --panel-2:#f0efec;
  --ink:#191a1b; --ink-2:#3d3e3f; --muted:#6e6d68;
  --rule:#e2e1dc; --rule-2:#d2d1cb;
  --gold:#0f7a7a; --gold-soft:#e4f3f3; --gold-line:#8fc4c4;
  --flow:#3f6bb0; --flow-soft:#e8eef8;
  --grok:#6f57a8; --grok-soft:#eeeaf7;
  --ok:#3f6b47; --ok-soft:#e5efe7;
  --warn:#9a6a12; --warn-soft:#f7edd8;
  --bad:#a63c33; --bad-soft:#f8e6e3;
  --shadow:0 1px 2px rgba(25,26,27,.06),0 8px 24px -16px rgba(25,26,27,.25);
  --sans:"PingFang SC","Microsoft YaHei UI","Microsoft YaHei","Hiragino Sans GB","Segoe UI",system-ui,-apple-system,sans-serif;
  --mono:"Cascadia Code","Cascadia Mono",Consolas,"SF Mono",ui-monospace,"Noto Sans Mono CJK SC",monospace;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#121313; --panel:#1a1b1c; --panel-2:#212223;
    --ink:#ecebe7; --ink-2:#cbc9c3; --muted:#918f88;
    --rule:#2c2d2e; --rule-2:#3a3b3c;
    --gold:#e0a94a; --gold-soft:#2b2317; --gold-line:#5c4720;
    --flow:#7ea6e0; --flow-soft:#1a2130;
    --grok:#a894d8; --grok-soft:#231e30;
    --ok:#7bb088; --ok-soft:#18231b;
    --warn:#d8a641; --warn-soft:#2a2214;
    --bad:#dd8478; --bad-soft:#2d1d1b;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px -16px rgba(0,0,0,.8);
  }
}
:root[data-theme="dark"]{
  --paper:#121313; --panel:#1a1b1c; --panel-2:#212223;
  --ink:#ecebe7; --ink-2:#cbc9c3; --muted:#918f88;
  --rule:#2c2d2e; --rule-2:#3a3b3c;
  --gold:#e0a94a; --gold-soft:#2b2317; --gold-line:#5c4720;
  --flow:#7ea6e0; --flow-soft:#1a2130;
  --grok:#a894d8; --grok-soft:#231e30;
  --ok:#7bb088; --ok-soft:#18231b;
  --warn:#d8a641; --warn-soft:#2a2214;
  --bad:#dd8478; --bad-soft:#2d1d1b;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px -16px rgba(0,0,0,.8);
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);
     font-size:16px;line-height:1.75;-webkit-font-smoothing:antialiased}
img{max-width:100%}

/* ---------- 版式骨架 ---------- */
.wrap{display:grid;grid-template-columns:260px minmax(0,1fr);gap:48px;
      max-width:1180px;margin:0 auto;padding:0 20px}
.toc{position:sticky;top:env(safe-area-inset-top,0px);align-self:start;
     max-height:100vh;overflow-y:auto;padding-block:32px 48px;font-size:13.5px}
.toc-brand{font-weight:700;font-size:15px;letter-spacing:.02em;margin-bottom:2px}
.toc-ver{color:var(--muted);font-size:12px;font-family:var(--mono);margin-bottom:20px}
.toc a{display:block;color:var(--muted);text-decoration:none;padding:3px 0 3px 12px;
       border-left:2px solid transparent;line-height:1.5}
.toc a:hover{color:var(--ink)}
.toc a.on{color:var(--gold);border-left-color:var(--gold);font-weight:600}
.toc a.sub{padding-left:26px;font-size:12.5px}
.toc .grp{margin-top:16px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;
          color:var(--muted);opacity:.7;padding-left:12px}
main{padding-block:32px 96px;min-width:0}
.col{max-width:70ch}

/* ---------- 文字层级 ---------- */
h1{font-size:34px;line-height:1.25;font-weight:700;letter-spacing:-.01em;margin:0 0 10px;text-wrap:balance}
h2{font-size:25px;line-height:1.3;font-weight:700;margin:0 0 6px;text-wrap:balance;scroll-margin-top:24px}
h3{font-size:18.5px;font-weight:650;margin:34px 0 8px;text-wrap:balance;scroll-margin-top:24px}
h4{font-size:15.5px;font-weight:650;margin:24px 0 6px;color:var(--ink-2)}
p{margin:0 0 14px}
a{color:var(--gold)}
ul,ol{margin:0 0 14px;padding-left:22px}
li{margin:4px 0}
li>ul,li>ol{margin:4px 0}
strong{font-weight:650}
hr{border:0;border-top:1px solid var(--rule);margin:52px 0}
.lede{font-size:18px;line-height:1.7;color:var(--ink-2);margin-bottom:26px}
.sec{padding-top:56px}
.sec:first-of-type{padding-top:0}
.eyebrow{font-family:var(--mono);font-size:12px;letter-spacing:.1em;color:var(--gold);
         text-transform:uppercase;margin-bottom:6px}

/* ---------- 行内元件 ---------- */
code{font-family:var(--mono);font-size:.875em;background:var(--panel-2);
     padding:1px 5px;border-radius:3px;word-break:break-word}
kbd{font-family:var(--mono);font-size:.82em;background:var(--panel);
    border:1px solid var(--rule-2);border-bottom-width:2px;border-radius:4px;
    padding:1px 6px;white-space:nowrap;color:var(--ink)}
.btn-ref{font-weight:600;color:var(--ink);white-space:nowrap}
.btn-ref::before{content:"「"}.btn-ref::after{content:"」"}
.chip{display:inline-block;font-size:12px;font-weight:600;padding:1px 8px;
      border-radius:10px;vertical-align:.08em;white-space:nowrap}
.chip.flow{background:var(--flow-soft);color:var(--flow)}
.chip.grok{background:var(--grok-soft);color:var(--grok)}
.chip.both{background:var(--panel-2);color:var(--muted)}
.panelno{display:inline-flex;align-items:center;justify-content:center;
         width:1.45em;height:1.45em;border-radius:50%;background:var(--gold);
         color:var(--paper);font-size:.8em;font-weight:700;vertical-align:.08em;
         margin-right:.2em;font-family:var(--mono)}

/* ---------- 步骤 ---------- */
ol.steps{list-style:none;padding:0;margin:18px 0;counter-reset:st}
ol.steps>li{counter-increment:st;position:relative;padding:0 0 20px 40px;
            border-left:1px solid var(--rule);margin:0}
ol.steps>li:last-child{border-left-color:transparent;padding-bottom:0}
ol.steps>li::before{content:counter(st);position:absolute;left:-13px;top:0;
  width:26px;height:26px;border-radius:50%;background:var(--panel);
  border:1px solid var(--rule-2);color:var(--ink-2);
  font-family:var(--mono);font-size:12.5px;font-weight:600;
  display:flex;align-items:center;justify-content:center}
ol.steps>li>b:first-child{display:block;margin-top:1px}

/* ---------- 提示块：三种，形态不同 ---------- */
.note{margin:20px 0;padding:14px 18px;border-left:3px solid var(--rule-2);
      background:var(--panel);font-size:15px}
.note>:last-child{margin-bottom:0}
.note .lbl{display:block;font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;
           font-weight:700;margin-bottom:4px;color:var(--muted)}
.note.tip{border-left-color:var(--gold);background:var(--gold-soft)}
.note.tip .lbl{color:var(--gold)}
.note.warn{border-left-color:var(--warn);background:var(--warn-soft)}
.note.warn .lbl{color:var(--warn)}
.note.trap{border-left:0;border:1px solid var(--bad);border-radius:6px;background:var(--bad-soft)}
.note.trap .lbl{color:var(--bad)}

/* ---------- 截图 ---------- */
figure.shot{margin:26px 0;max-width:none}
figure.shot img{display:block;width:100%;border:1px solid var(--rule-2);
                border-radius:8px;box-shadow:var(--shadow);cursor:zoom-in;background:var(--panel)}
figure.shot figcaption{font-size:13.5px;color:var(--muted);margin-top:8px;line-height:1.6}
figure.shot figcaption b{color:var(--ink-2);font-weight:600}
.shot-todo{display:flex;align-items:center;justify-content:center;text-align:center;
  min-height:150px;border:1px dashed var(--rule-2);border-radius:8px;
  background:var(--panel-2);color:var(--muted);font-family:var(--mono);
  font-size:13px;padding:24px;line-height:1.7}

/* ---------- 表格 ---------- */
.tw{overflow-x:auto;margin:20px 0;border:1px solid var(--rule);border-radius:8px;background:var(--panel)}
table{border-collapse:collapse;width:100%;font-size:14.5px;min-width:520px}
th{text-align:left;font-weight:650;font-size:12.5px;letter-spacing:.04em;color:var(--muted);
   padding:10px 14px;border-bottom:1px solid var(--rule-2);white-space:nowrap;background:var(--panel-2)}
td{padding:10px 14px;border-bottom:1px solid var(--rule);vertical-align:top}
tr:last-child td{border-bottom:0}
td:first-child{white-space:nowrap}
table.keys td:first-child{font-family:var(--mono);color:var(--gold);font-weight:600}
table.wide td:first-child{white-space:normal}

/* ---------- 代码块 ---------- */
pre{font-family:var(--mono);font-size:13px;line-height:1.65;background:var(--panel);
    border:1px solid var(--rule);border-radius:8px;padding:14px 16px;
    overflow-x:auto;margin:18px 0}
pre code{background:none;padding:0;font-size:inherit}

/* ---------- 流程图 ---------- */
.flow-map{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:28px 0}
.flow-map .node{background:var(--panel);border:1px solid var(--rule-2);border-radius:8px;
  padding:12px 12px 14px;position:relative}
.flow-map .node b{display:block;font-size:15px;margin:6px 0 2px}
.flow-map .node span{font-size:12.5px;color:var(--muted);line-height:1.5;display:block}
.flow-map .node .n{font-family:var(--mono);font-size:11px;color:var(--gold);font-weight:700}

/* ---------- 引擎对照 ---------- */
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:22px 0}
.two>div{background:var(--panel);border:1px solid var(--rule);border-radius:8px;padding:16px 18px}
.two>div h4{margin-top:0}
.two>div p:last-child,.two>div ul:last-child{margin-bottom:0}

/* ---------- 灯箱 ---------- */
#lb{position:fixed;inset:0;background:rgba(10,10,10,.92);display:none;
    align-items:center;justify-content:center;z-index:99;padding:24px;cursor:zoom-out}
#lb.on{display:flex}
#lb img{max-width:100%;max-height:92vh;border-radius:6px;box-shadow:0 20px 60px rgba(0,0,0,.6)}
#lb .hint{position:absolute;bottom:18px;left:0;right:0;text-align:center;
          color:rgba(255,255,255,.6);font-size:12.5px}

/* ---------- 窄屏 ---------- */
@media (max-width:900px){
  .wrap{grid-template-columns:1fr;gap:0}
  .toc{position:static;max-height:none;border-bottom:1px solid var(--rule);
       padding-block:20px;margin-bottom:8px}
  .toc-nav{columns:2;column-gap:20px}
  .flow-map{grid-template-columns:1fr 1fr}
  .two{grid-template-columns:1fr}
  main{padding-block:16px 64px}
}
@media (max-width:520px){
  body{font-size:15.5px}
  h1{font-size:27px} h2{font-size:22px}
  .flow-map{grid-template-columns:1fr}
  /* 400px 手机宽度仍保持目录两栏（规格 72 验收） */
  .toc-nav{columns:2;column-gap:16px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

<style>
.hero{padding:48px 0 12px}
.hero h1{font-size:34px;line-height:1.25;margin:8px 0 12px}
.flow-map{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin:20px 0 8px}
@media(max-width:900px){.flow-map{grid-template-columns:1fr 1fr}}
.flow-map .node{background:var(--panel);border:1px solid var(--rule);border-radius:12px;padding:14px 14px 16px;box-shadow:var(--shadow)}
.flow-map .n{display:inline-block;font-family:var(--mono);font-size:12px;color:var(--gold);margin-bottom:6px}
.flow-map b{display:block;font-size:15px;margin-bottom:4px}
.flow-map span{display:block;color:var(--muted);font-size:13px;line-height:1.45}
code{font-family:var(--mono);font-size:.92em;background:var(--panel-2);padding:.1em .35em;border-radius:4px}
pre{background:var(--panel);border:1px solid var(--rule);border-radius:12px;padding:14px 16px;overflow:auto}
pre code{background:transparent;padding:0}
.sec{padding:28px 0 8px}
.sec h2{font-size:22px;margin:0 0 12px}
.sec h3{font-size:17px;margin:22px 0 8px}
footer.foot{color:var(--muted);font-size:13px;padding:40px 0 64px}
</style>

