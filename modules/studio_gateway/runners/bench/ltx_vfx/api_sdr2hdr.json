{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ltx-2.5-22b-distilled-transformer-nvfp4.safetensors",
   "weight_dtype": "default"
  }
 },
 "lora": {
  "class_type": "LTXICLoRALoaderModelOnly",
  "inputs": {
   "lora_name": "ltx-2.5-22b-ic-lora-sdr-to-hdr-1.0.safetensors",
   "strength_model": 1.0,
   "model": [
    "unet",
    0
   ]
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-video-vae-bf16.safetensors"
  }
 },
 "vae32": {
  "class_type": "LTXVVAEForceFloat32",
  "inputs": {
   "vae": [
    "vae",
    0
   ]
  }
 },
 "avae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ltx-2.5-audio-vae-bf16.safetensors"
  }
 },
 "emb": {
  "class_type": "LTXVLoadConditioning",
  "inputs": {
   "file_name": "ltx-2.5-22b-ic-lora-sdr-to-hdr-scene-emb.safetensors",
   "device": "cpu"
  }
 },
 "lv": {
  "class_type": "LoadVideo",
  "inputs": {
   "file": "hdr_in.mp4"
  }
 },
 "gvc": {
  "class_type": "GetVideoComponents",
  "inputs": {
   "video": [
    "lv",
    0
   ]
  }
 },
 "ws": {
  "class_type": "LTXVSDRToHDRWorkingSpace",
  "inputs": {
   "image": [
    "gvc",
    0
   ],
   "color_space": "srgb_gamma"
  }
 },
 "rs": {
  "class_type": "ResizeImageMaskNode",
  "inputs": {
   "input": [
    "ws",
    0
   ],
   "resize_type": "scale to multiple",
   "resize_type.multiple": 32,
   "scale_method": "lanczos"
  }
 },
 "size": {
  "class_type": "GetImageSize",
  "inputs": {
   "image": [
    "rs",
    0
   ]
  }
 },
 "cfps": {
  "class_type": "ComfyMathExpression",
  "inputs": {
   "expression": "a if a <= 30 else 30",
   "values.a": [
    "gvc",
    2
   ]
  }
 },
 "cond": {
  "class_type": "LTXVConditioning",
  "inputs": {
   "positive": [
    "emb",
    0
   ],
   "negative": [
    "emb",
    0
   ],
   "frame_rate": [
    "cfps",
    0
   ]
  }
 },
 "empty": {
  "class_type": "EmptyLTXVLatentVideo",
  "inputs": {
   "width": [
    "size",
    0
   ],
   "height": [
    "size",
    1
   ],
   "length": [
    "size",
    2
   ],
   "batch_size": 1
  }
 },
 "guide": {
  "class_type": "LTXAddVideoICLoRAGuide",
  "inputs": {
   "positive": [
    "cond",
    0
   ],
   "negative": [
    "cond",
    1
   ],
   "vae": [
    "vae32",
    0
   ],
   "latent": [
    "empty",
    0
   ],
   "image": [
    "rs",
    0
   ],
   "frame_idx": 0,
   "strength": 1.0,
   "latent_downscale_factor": [
    "lora",
    1
   ],
   "crop": "disabled",
   "use_tiled_encode": false,
   "tile_size": 256,
   "tile_overlap": 64
  }
 },
 "alat": {
  "class_type": "LTXVEmptyLatentAudio",
  "inputs": {
   "frames_number": [
    "size",
    2
   ],
   "frame_rate": [
    "cfps",
    0
   ],
   "batch_size": 1,
   "audio_vae": [
    "avae",
    0
   ]
  }
 },
 "cat": {
  "class_type": "LTXVConcatAVLatent",
  "inputs": {
   "video_latent": [
    "guide",
    2
   ],
   "audio_latent": [
    "alat",
    0
   ]
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": 42
  }
 },
 "cfg": {
  "class_type": "CFGGuider",
  "inputs": {
   "cfg": 1,
   "model": [
    "lora",
    0
   ],
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ]
  }
 },
 "ks": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler"
  }
 },
 "sig": {
  "class_type": "ManualSigmas",
  "inputs": {
   "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"
  }
 },
 "samp": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "cfg",
    0
   ],
   "sampler": [
    "ks",
    0
   ],
   "sigmas": [
    "sig",
    0
   ],
   "latent_image": [
    "cat",
    0
   ]
  }
 },
 "sep": {
  "class_type": "LTXVSeparateAVLatent",
  "inputs": {
   "av_latent": [
    "samp",
    0
   ]
  }
 },
 "crop": {
  "class_type": "LTXVCropGuides",
  "inputs": {
   "positive": [
    "guide",
    0
   ],
   "negative": [
    "guide",
    1
   ],
   "latent": [
    "sep",
    0
   ]
  }
 },
 "dec": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "crop",
    2
   ],
   "vae": [
    "vae32",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 64,
   "temporal_overlap": 8
  }
 },
 "post": {
  "class_type": "LTXVHDRDecodePostprocess",
  "inputs": {
   "image": [
    "dec",
    0
   ],
   "transfer": "acescct",
   "exposure": 0.0,
   "save_exr": false,
   "exr_color_space": "acescg",
   "output_dir": "ltx_hdr/exr",
   "filename_prefix": "frame",
   "half_precision": true
  }
 },
 "hlg": {
  "class_type": "LTXVSaveHLG",
  "inputs": {
   "hdr_linear": [
    "post",
    1
   ],
   "frame_rate": [
    "gvc",
    2
   ],
   "filename_prefix": "ltx_hdr/hlg",
   "linear_primaries": "acescg",
   "audio": [
    "gvc",
    1
   ]
  }
 },
 "cv": {
  "class_type": "CreateVideo",
  "inputs": {
   "images": [
    "post",
    0
   ],
   "fps": [
    "gvc",
    2
   ],
   "audio": [
    "gvc",
    1
   ]
  }
 },
 "save": {
  "class_type": "SaveVideo",
  "inputs": {
   "filename_prefix": "ltx_hdr/sdr_tonemapped",
   "format": "auto",
   "codec": "auto",
   "video": [
    "cv",
    0
   ]
  }
 }
}